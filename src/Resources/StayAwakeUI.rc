IDD_STAYAWAKE_DOCKPANEL DIALOGEX 26, 41, 211, 243
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "<StayAwake>"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    PUSHBUTTON      "Select multiple &options for random simulation",IDC_SELECT_INPUT_OPTIONS_BTN,13,12,179,14
    RTEXT           "&Minimum Awake Seconds:",IDC_STATIC,0,38,100,8
    EDITTEXT        IDC_INTERVAL_MIN_EDIT,102,35,27,13,ES_NUMBER
    RTEXT           "Ma&ximum Awake Seconds:",IDC_STATIC,0,58,100,8
    EDITTEXT        IDC_INTERVAL_MAX_EDIT,102,55,27,13,ES_NUMBER
    PUSHBUTTON      "Set &Timer",IDC_SET_TIMER_BTN,138,34,54,34
    RTEXT           "",IDC_LAST_EVENT_TIME_INFO,0,77,143,8
    RTEXT           "",IDC_LAST_EVENT_INPUT_INFO,0,85,143,8
    RTEXT           "",IDC_NEXT_EVENT_TIME_INFO,0,95,143,8
    CONTROL         "&Stealth Mode",IDC_STEALTH_MODE_CBX,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,117,55,10
    PUSHBUTTON      "&Pause",IDC_PAUSE_RESUME_BTN,80,114,50,14
    PUSHBUTTON      "&Close",IDCLOSE,142,114,50,14
    PUSHBUTTON      "...",IDC_ABOUT_BTN,166,417,15,13,BS_BITMAP
END


IDD_SELECT_KEYCODES_DIALOG DIALOGEX 0, 0, 330, 205
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
