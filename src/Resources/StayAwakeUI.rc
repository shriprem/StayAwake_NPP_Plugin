    CONTROL         "Extended FN Key: F14",IDC_KEY_F14,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,120,30,90,10
    CONTROL         "Extended FN Key: F15",IDC_KEY_F15,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,120,45,90,10
    CONTROL         "Extended FN Key: F16",IDC_KEY_F16,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,120,60,90,10
    CONTROL         "Extended FN Key: F17",IDC_KEY_F17,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,120,75,90,10
