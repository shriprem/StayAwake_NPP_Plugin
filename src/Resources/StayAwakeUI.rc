    PUSHBUTTON      "Select &None",IDC_KEY_SELECT_NONE_BTN,225,55,85,14
    PUSHBUTTON      "Select All &Unassigned", IDC_KEY_SELECT_ALL_UNASSGND_BTN,225,80,85,14
    PUSHBUTTON      "Select All Ext. &FN Keys", IDC_KEY_SELECT_ALL_EXT_FN_BTN,225,105,85,14
    PUSHBUTTON      "Select &All",IDC_KEY_SELECT_ALL_BTN,225,130,85,14
