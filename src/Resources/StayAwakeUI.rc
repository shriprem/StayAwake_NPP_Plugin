    CONTROL         "Extended FN Key: F20",IDC_KEY_F20,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,120,120,90,10
    CONTROL         "Extended FN Key: F21",IDC_KEY_F21,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,120,135,90,10
    CONTROL         "Extended FN Key: F22",IDC_KEY_F22,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,120,150,90,10
    CONTROL         "Extended FN Key: F23",IDC_KEY_F23,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,120,165,90,10
    CONTROL         "Extended FN Key: F24",IDC_KEY_F24,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,120,180,90,10
